download :
ifeq (,$(wildcard $(ASTRO_HOME)/bin/axor3344-2_portocel/axor-3344-3.obj))
	$(info )
	$(info **************** **********************************************************************************************)
	$(info *	Dowloading 3D model Mercedes Axor 3344 without the trailer)
	$(info * Dont worry if the .mtl returns error, the gdown doesn't work properly wtth small files *)
	$(info * Check the file and if necessary, download it direct from the link in this makefie *)
	$(info ***************************************************************************************************************)
	$(info )
	$(ASTRO_HOME)/bin/gdown.pl https://drive.google.com/file/d/1UB5KjNxa7mDUreYBYL0B3-Qmt8IeHySk/view?usp=share_link $(ASTRO_HOME)/bin/axor3344-2_portocel/axor-3344-3.obj
else

	$(info * The axor-3344-3.obj 3D model already exists *)
endif

