<?xml version="1.0"?>
<package format="3">
  <name>removert</name><version>1.0.0</version>
  <description>Native ROS2 LT-mapper removert processing</description>
  <maintainer email="paulgkim@kaist.ac.kr">Giseop Kim</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
