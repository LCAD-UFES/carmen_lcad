<launch>
    <arg name="use_sim_time" default="false"/> 
    <param name="/use_sim_time" value="$(arg use_sim_time)"/>

    <arg name="project" default="lio_sam"/>
    
    <arg name="params_file"/>

    <!-- Localization mode: reuse an existing map only to localize (does NOT erase/overwrite it). -->
    <!-- Usage: roslaunch lio_sam run.launch localizationMode:=true -->
    <arg name="localizationMode" default="false"/>
    <!-- Initial pose of the robot inside the map (map frame). Only used when localizationMode is true. -->
    <arg name="initialPoseX" default="0.0"/>
    <arg name="initialPoseY" default="0.0"/>
    <arg name="initialPoseZ" default="0.0"/>
    <arg name="initialPoseRoll" default="0.0"/>
    <arg name="initialPosePitch" default="0.0"/>
    <arg name="initialPoseYaw" default="0.0"/>

    <!-- Busca de mapa (kNN corner/surf + downsample) na GPU via CUDA.
         Padrao FALSE: no carro a GPU ja' fica ocupada com a IA, e localizar
         contra mapa fixo e' leve o suficiente pra CPU dar conta.
         Usage: roslaunch lio_sam run.launch localizationMode:=true gpu:=true -->
    <arg name="gpu" default="false"/>

    <!-- Sobe o RViz junto (config rviz_alberto.rviz)? Default TRUE preserva o
         comportamento de sempre. Usage: roslaunch lio_sam run.launch rviz:=false.
         Util quando a visualizacao ja' vai ser feita pelo viewer_3D/navigator_gui
         do CARMEN, pra' nao rodar duas GUIs de mapa 3D (+ o mapa carregado do
         SC-LIO-SAM) disputando RAM/CPU ao mesmo tempo. -->
    <arg name="rviz" default="true"/>

    <rosparam file="$(arg params_file)" command="load" />

    <!-- Override params from the launch flags (take precedence over the yaml file). -->
    <param name="lio_sam/localizationMode" value="$(arg localizationMode)"/>
    <param name="lio_sam/initialPoseX" value="$(arg initialPoseX)"/>
    <param name="lio_sam/initialPoseY" value="$(arg initialPoseY)"/>
    <param name="lio_sam/initialPoseZ" value="$(arg initialPoseZ)"/>
    <param name="lio_sam/initialPoseRoll" value="$(arg initialPoseRoll)"/>
    <param name="lio_sam/initialPosePitch" value="$(arg initialPosePitch)"/>
    <param name="lio_sam/initialPoseYaw" value="$(arg initialPoseYaw)"/>
    <param name="lio_sam/useGpu" value="$(arg gpu)"/>

    <param name="$(arg project)/savePCDDirectory" type="string" value="$(arg savePCDDirectory)" />

    <include file="$(find lio_sam)/launch/include/module_loam.launch" />

    <include file="$(find lio_sam)/launch/include/module_robot_state_publisher.launch" />

    <!-- include file="$(find lio_sam)/launch/include/module_navsat.launch" /-->

    <include file="$(find lio_sam)/launch/include/module_rviz.launch" if="$(arg rviz)"/>

</launch>