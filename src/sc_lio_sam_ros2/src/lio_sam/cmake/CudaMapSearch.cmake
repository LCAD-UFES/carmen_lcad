option(LIO_SAM_ENABLE_CUDA "Build optional CUDA map search when a toolkit is available" ON)
include(CheckLanguage)
set(_map_cuda_available FALSE)
if(LIO_SAM_ENABLE_CUDA)
  if(NOT CMAKE_CUDA_COMPILER)
    find_program(_map_nvcc nvcc HINTS "$ENV{CUDA_PATH}/bin" /usr/local/cuda/bin)
    if(_map_nvcc)
      set(CMAKE_CUDA_COMPILER "${_map_nvcc}" CACHE FILEPATH "CUDA compiler" FORCE)
    endif()
  endif()
  check_language(CUDA)
  if(CMAKE_CUDA_COMPILER)
    set(_map_cuda_available TRUE)
  endif()
endif()
if(_map_cuda_available)
  if(CMAKE_VERSION VERSION_LESS 3.18)
    # CMake 3.16 cannot test CUDA C++17 through CUDA_STANDARD.
    set(_map_cuda_standard_defined FALSE)
    if(DEFINED CMAKE_CUDA_STANDARD)
      set(_map_cuda_standard_defined TRUE)
      set(_map_cuda_saved_standard "${CMAKE_CUDA_STANDARD}")
    endif()
    set(CMAKE_CUDA_STANDARD "")
  endif()
  enable_language(CUDA)
  if(CMAKE_VERSION VERSION_LESS 3.18)
    if(_map_cuda_standard_defined)
      set(CMAKE_CUDA_STANDARD "${_map_cuda_saved_standard}")
    else()
      unset(CMAKE_CUDA_STANDARD)
    endif()
  endif()
  set(_map_cuda_archs)
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.0)
    list(APPEND _map_cuda_archs 52-real 61-real)
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 10.0)
    list(APPEND _map_cuda_archs 75)
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 11.1)
    list(APPEND _map_cuda_archs 86)
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 11.8)
    list(APPEND _map_cuda_archs 89)
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 12.8)
    list(APPEND _map_cuda_archs 120)
  endif()
  add_library(cuda_map_search STATIC src/cuda_map_search.cu)
  set_target_properties(cuda_map_search PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(CMAKE_VERSION VERSION_LESS 3.18)
    # Set equivalent nvcc flags without the newer CMake CUDA properties.
    set_property(TARGET cuda_map_search PROPERTY CUDA_STANDARD)
    set(_map_cuda_standard 17)
    if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 9.0)
      set(_map_cuda_standard 11)
    elseif(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 11.0)
      set(_map_cuda_standard 14)
    endif()
    target_compile_options(cuda_map_search PRIVATE
      "$<$<COMPILE_LANGUAGE:CUDA>:-std=c++${_map_cuda_standard}>")
    foreach(_map_cuda_arch IN LISTS _map_cuda_archs)
      string(REGEX REPLACE "-(real|virtual)$" "" _map_cuda_number "${_map_cuda_arch}")
      if(_map_cuda_arch MATCHES "-real$")
        set(_map_cuda_code "sm_${_map_cuda_number}")
      elseif(_map_cuda_arch MATCHES "-virtual$")
        set(_map_cuda_code "compute_${_map_cuda_number}")
      else()
        set(_map_cuda_code "[compute_${_map_cuda_number},sm_${_map_cuda_number}]")
      endif()
      target_compile_options(cuda_map_search PRIVATE
        "$<$<COMPILE_LANGUAGE:CUDA>:--generate-code=arch=compute_${_map_cuda_number},code=${_map_cuda_code}>")
    endforeach()
    message(STATUS "CUDA map search enabled with CMake 3.16-compatible nvcc flags")
  else()
    set_target_properties(cuda_map_search PROPERTIES CUDA_STANDARD 17
      CUDA_ARCHITECTURES "${_map_cuda_archs}")
  endif()
  target_compile_definitions(cuda_map_search PUBLIC WITH_CUDA_MAP_SEARCH)
else()
  add_library(cuda_map_search STATIC src/cuda_map_search_stub.cpp)
  message(STATUS "Mapping uses the CPU-only CUDA fallback")
endif()
target_include_directories(cuda_map_search PUBLIC include)
